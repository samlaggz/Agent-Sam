APP_NAME=Agent Sam
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://agent_sam:agent_sam@localhost:5432/agent_sam
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
VECTOR_BACKEND=qdrant
TELEGRAM_BOT_TOKEN=
DEFAULT_WORKSPACE_ID=
DEFAULT_USER_ID=
LITELLM_MODEL=gpt-4.1-mini
LITELLM_API_KEY=

# When running inside the devcontainer, replace localhost with service names:
# DATABASE_URL=postgresql+psycopg://agent_sam:agent_sam@postgres:5432/agent_sam
# REDIS_URL=redis://redis:6379/0
# QDRANT_URL=http://qdrant:6333
# DEFAULT_WORKSPACE_ID and DEFAULT_USER_ID must point at existing database rows.
