APP_NAME=Agent Sam
APP_ENV=production
ENVIRONMENT=production
API_HOST=127.0.0.1
API_PORT=8000
# Linux production without Docker:
# - keep secrets only in .env
# - point DATABASE_URL, REDIS_URL, and QDRANT_URL at external or host-installed services
# - set DEFAULT_WORKSPACE_ID and DEFAULT_USER_ID to existing production rows
# - only enable telegram after TELEGRAM_BOT_TOKEN is configured
DATABASE_URL=postgresql+psycopg://agent_sam_user:CHANGE_ME@127.0.0.1:5432/agent_sam
REDIS_URL=redis://127.0.0.1:6379/0
QDRANT_URL=http://127.0.0.1:6333
VECTOR_BACKEND=qdrant
ENABLED_GATEWAYS=telegram
GATEWAY_DEBUG_LOGGING=false
TELEGRAM_BOT_TOKEN=
WHATSAPP_PROVIDER=twilio
WHATSAPP_TWILIO_ACCOUNT_SID=
WHATSAPP_TWILIO_AUTH_TOKEN=
WHATSAPP_TWILIO_FROM=
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_VERIFY_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
WEBHOOK_GATEWAY_SECRET=
DEFAULT_WORKSPACE_ID=
DEFAULT_USER_ID=
LITELLM_MODEL=openrouter/openai/gpt-4.1-mini
LITELLM_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=openrouter/openai/gpt-4.1-mini
ROUTER_AGENT_MODEL=openrouter/openai/gpt-4.1-mini
CODING_AGENT_MODEL=openrouter/openai/gpt-4.1-mini
CODING_AGENT_ESCALATION_MODEL=openrouter/anthropic/claude-3.7-sonnet
TESTING_AGENT_MODEL=openrouter/google/gemini-2.0-flash-001
TESTING_AGENT_ESCALATION_MODEL=openrouter/openai/gpt-4.1
RESEARCH_AGENT_MODEL=openrouter/google/gemini-2.0-flash-001
RESEARCH_AGENT_ESCALATION_MODEL=openrouter/anthropic/claude-3.7-sonnet
PLANNING_AGENT_MODEL=openrouter/openai/gpt-4.1-mini
PLANNING_AGENT_ESCALATION_MODEL=openrouter/anthropic/claude-3.7-sonnet
SERVER_OPS_AGENT_MODEL=openrouter/openai/gpt-4.1-mini
SERVER_OPS_AGENT_ESCALATION_MODEL=openrouter/anthropic/claude-3.7-sonnet
GRAPHICS_AGENT_MODEL=openrouter/google/gemini-2.0-flash-001
GRAPHICS_AGENT_ESCALATION_MODEL=openrouter/anthropic/claude-3.7-sonnet
DATA_AGENT_MODEL=openrouter/openai/gpt-4.1-mini
DATA_AGENT_ESCALATION_MODEL=openrouter/anthropic/claude-3.7-sonnet
QA_AGENT_MODEL=openrouter/openai/gpt-4.1-mini
QA_AGENT_ESCALATION_MODEL=openrouter/anthropic/claude-3.7-sonnet
MAX_COST_PER_TASK_USD=0.25
DAILY_MODEL_BUDGET_USD=5.0
ALLOW_MODEL_ESCALATION=true
ALLOW_SKILL_AUTO_PROPOSAL=true
ALLOW_SKILL_AUTO_ACTIVATION=false
ALLOW_SUB_AGENT_PROPOSAL=true
ALLOW_SUB_AGENT_AUTO_CREATION=false
ENABLE_WEB_RESEARCH=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# When running inside the devcontainer, replace localhost with service names:
# DATABASE_URL=postgresql+psycopg://agent_sam:agent_sam@postgres:5432/agent_sam
# REDIS_URL=redis://redis:6379/0
# QDRANT_URL=http://qdrant:6333
# ENABLED_GATEWAYS accepts a comma-separated list such as: telegram,cli or cli,webhook
# DEFAULT_WORKSPACE_ID and DEFAULT_USER_ID must point at existing database rows.
# Run `python scripts/seed_dev.py` after migrations to generate development IDs.
# OpenRouter models should use: openrouter/provider/model-name
# Per-agent model keys let you keep the router cheap while escalating specific specialists.
# MAX_COST_PER_TASK_USD and DAILY_MODEL_BUDGET_USD control live model routing spend.
# ALLOW_SKILL_AUTO_ACTIVATION and ALLOW_SUB_AGENT_AUTO_CREATION should stay false unless you explicitly want auto-activation.
# For Linux production, use `python -m scripts.doctor --production` after configuring .env.
